{
  "name": "AI Lead Responder – Clinic",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the friendly front-desk assistant for Bright Smile Dental. A patient just sent an enquiry through our website.\n\nName: {{ $json.Name }}\nService: {{ $json.Service }}\nMessage: {{ $json.Message }}\n\n1. Rate the lead:\n- Hot = in pain, an emergency, or wants an appointment soon\n- Warm = interested in a treatment but no timing\n- Cold = vague, spam, or unrelated\n\n2. Write a short, warm email reply (under 120 words) using their first name. Acknowledge what they asked for. If they mention pain or an emergency, ask them to call us on (555) 010-2024 for a same-day slot. Otherwise invite them to reply with 2–3 days and times that suit them. Sign off as \"The Bright Smile Dental Team\".\n\nRules: never give medical advice or diagnoses, never quote prices, never confirm a specific appointment time, and never make up facts about the clinic.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
